<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/live_dialogue_panel">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live chat reply"
        android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/jarvis_primary" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <TextView android:id="@+id/tvLiveDialogueReply" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="?attr/jarvis_on_dark" android:paddingBottom="8dp" android:accessibilityLiveRegion="polite" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseLiveDialogue" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Close reply" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEndLiveDialogue" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="End live chat" />
    </LinearLayout>
</LinearLayout>
