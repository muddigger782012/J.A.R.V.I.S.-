<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/jarvis_background" android:padding="16dp" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" android:background="@drawable/glass_panel_surface">
        <Button android:id="@+id/btnCloseAssistantVoice" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Assistant voice" android:textColor="?attr/jarvis_on_dark" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Voice responses" android:textColor="?attr/jarvis_primary" android:textSize="18sp" android:textStyle="bold" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchRegularSpeech"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Speak responses outside live chat" android:textColor="?attr/jarvis_on_dark" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchLiveSpeech"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Speak live chat responses" android:textColor="?attr/jarvis_on_dark" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchLiveDialogue"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Show live chat dialogue popup" android:textColor="?attr/jarvis_on_dark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp"
            android:text="These switches save immediately. Muting speech keeps replies in chat and history. The popup shows the latest reply."
            android:textColor="?attr/jarvis_on_dark_muted" />
        <Button android:id="@+id/btnLiveDialoguePermission" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Allow dialogue over other apps" />
        <TextView android:id="@+id/tvLiveDialoguePermission" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="?attr/jarvis_on_dark_muted" />
        <Button android:id="@+id/btnLiveChatHistory" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Live chat history" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Choose a profile, listen to a sample, then tap Use this voice."
            android:textColor="?attr/jarvis_on_dark_muted" android:textSize="16sp" />
        <RadioGroup android:id="@+id/assistantVoiceProfiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/voiceOriginal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="JARVIS — Original" android:textColor="?attr/jarvis_on_dark" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/voiceFemale"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="Default (Female)" android:textColor="?attr/jarvis_on_dark" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Original uses dedicated Kokoro male voices after a one-time download. Choose George, Lewis or Michael and audition the sample. Default (Female) keeps your Android voice. Until the pack is installed, speech uses a clearly reported female fallback."
            android:textColor="?attr/jarvis_on_dark_muted" android:textSize="15sp" />
        <TextView android:id="@+id/tvAssistantVoiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Starting speech engine…" android:textColor="?attr/jarvis_on_dark"
            android:textSize="16sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/btnChooseAssistantVoice" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="Choose voice" />
        <Button android:id="@+id/btnDownloadNeuralVoice" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Download male voices" />
        <Button android:id="@+id/btnNeuralVoiceCredits" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Offline voice credits" />
        <Button android:id="@+id/btnPreviewAssistantVoice" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Preview voice" />
        <Button android:id="@+id/btnUseAssistantVoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Use this voice" />
        <Button android:id="@+id/btnVoiceDiagnostics" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Voice diagnostics" />
        <Button android:id="@+id/btnClearVoiceCache" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Clear phrase audio cache" />
        <Button android:id="@+id/btnAndroidSpeechSettings" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Android speech settings" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="Personality and phrases" android:textColor="?attr/jarvis_primary" android:textSize="20sp" android:textStyle="bold" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchPersonality"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="JARVIS personality" android:textColor="?attr/jarvis_on_dark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Form of address (blank for none)"
            android:labelFor="@id/editPersonalityAddress" android:textColor="?attr/jarvis_on_dark" />
        <EditText android:id="@+id/editPersonalityAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="textCapWords" android:maxLength="40" android:singleLine="true"
            android:textColor="?attr/jarvis_on_dark" android:textColorHint="?attr/jarvis_on_dark_muted" android:hint="Sir or Brandon" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reply detail" android:textColor="?attr/jarvis_on_dark" />
        <RadioGroup android:id="@+id/personalityDetail" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/detailBrief" android:text="Brief"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textColor="?attr/jarvis_on_dark" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/detailBalanced" android:text="Balanced"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textColor="?attr/jarvis_on_dark" />
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/detailDetailed" android:text="Detailed"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textColor="?attr/jarvis_on_dark" />
        </RadioGroup>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchPersonalityHumor"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Occasional dry wit" android:textColor="?attr/jarvis_on_dark" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchPersonalityInitiative"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Suggest a useful next step" android:textColor="?attr/jarvis_on_dark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Introduction phrase"
            android:labelFor="@id/editAssistantIntroduction" android:textColor="?attr/jarvis_on_dark" />
        <EditText android:id="@+id/editAssistantIntroduction" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="80dp" android:inputType="textCapSentences|textMultiLine" android:maxLength="500" android:gravity="top"
            android:textColor="?attr/jarvis_on_dark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wake responses (one per line; blank for silent)"
            android:labelFor="@id/editWakeReplies" android:textColor="?attr/jarvis_on_dark" />
        <EditText android:id="@+id/editWakeReplies" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="96dp" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000" android:gravity="top"
            android:textColor="?attr/jarvis_on_dark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp"
            android:text="Save these controls separately from the voice selection. AI replies follow the profile; local action results remain factual. The introduction plays when you enable voice. Wake responses rotate before command listening. Speech switches still apply."
            android:textColor="?attr/jarvis_on_dark_muted" />
        <Button android:id="@+id/btnSavePersonality" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Save personality and phrases" />
    </LinearLayout>
</ScrollView>
