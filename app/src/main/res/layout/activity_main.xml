<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_jarvis_space"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/jarvisHeader"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="12dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_jarvis_core" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="J.A.R.V.I.S." android:textSize="21sp" android:textStyle="bold" android:letterSpacing="0.08"
                android:textColor="@color/jarvis_on_dark" />
            <TextView android:id="@+id/tvAssistantState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ui_ready" android:textSize="12sp" android:layout_marginTop="4dp" android:textColor="@color/jarvis_secondary" />
        </LinearLayout>
        <Button android:id="@+id/btnVoiceSettings" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_settings" />
    </LinearLayout>
    <LinearLayout android:id="@+id/jarvisNavigation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:orientation="horizontal">
        <Button android:id="@+id/btnOpenJarvisChat" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_chat" />
        <Button android:id="@+id/btnOpenTools" style="@style/Widget.AssistantPlatform.QuietButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ui_tools" />
    </LinearLayout>
    <TextView android:id="@+id/tvScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginTop="8dp" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/headerTabScroller"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/headerTabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHeaderAssistant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/tab_assistant" />

            <Button
                android:id="@+id/btnHeaderProject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/tab_project" />

            <Button
                android:id="@+id/btnHeaderShizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/tab_shizuku" />

            <Button
                android:id="@+id/btnHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/tab_status" />

            <Button
                android:id="@+id/btnHeaderTerminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/tab_terminal" />

            <Button
                android:id="@+id/btnHeaderAudit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/tab_audit" />

            <Button
                android:id="@+id/btnHeaderPermissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/tab_permissions" />

            <Button
                android:id="@+id/btnHeaderDhizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_dhizuku" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:layout_weight="1">

        <LinearLayout android:id="@+id/tabAssistantSection"
            android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
            <LinearLayout android:id="@+id/conversationToolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/ui_conversation" android:textColor="@color/jarvis_on_dark_muted" android:textSize="12sp" />
                <Button android:id="@+id/btnNewAssistantChat" style="@style/Widget.AssistantPlatform.QuietButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_new_chat" />
                <Button android:id="@+id/btnAssistantHistory" style="@style/Widget.AssistantPlatform.QuietButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_history" />
            </LinearLayout>
            <LinearLayout android:id="@+id/micPermissionCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/glass_panel_surface" android:padding="12dp" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/tvMicPermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ui_mic_hint" android:textSize="13sp" />
                <Button android:id="@+id/btnGrantMicPermission" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ui_enable_mic" />
            </LinearLayout>
            <ScrollView android:id="@+id/conversationScroll" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false" android:paddingVertical="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/chatEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="24dp" android:layout_marginTop="20dp" android:gravity="center_horizontal" android:orientation="vertical">
                        <ImageView android:layout_width="88dp" android:layout_height="88dp" android:src="@drawable/ic_jarvis_core" android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                            android:text="@string/ui_welcome" android:textSize="24sp" android:textStyle="bold" android:gravity="center" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                            android:text="@string/ui_welcome_hint" android:textSize="15sp" android:textColor="@color/jarvis_on_dark_muted" android:gravity="center" android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/chatMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:id="@+id/tvOutputLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
            <HorizontalScrollView android:id="@+id/quickPromptScroller" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnSuggestWeather" style="@style/Widget.AssistantPlatform.QuietButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_weather" />
                    <Button android:id="@+id/btnSuggestMaps" style="@style/Widget.AssistantPlatform.QuietButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ui_maps" />
                    <Button android:id="@+id/btnSuggestMusic" style="@style/Widget.AssistantPlatform.QuietButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ui_music" />
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <EditText android:id="@+id/etCommandInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="@string/ui_message_hint" android:inputType="textCapSentences" android:imeOptions="actionSend" android:singleLine="true" android:minHeight="52dp" android:textSize="16sp" />
                <Button android:id="@+id/btnRunAssistantCommand" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="@string/ui_send" android:minHeight="52dp" />
            </LinearLayout>
            <Button android:id="@+id/btnToggleVoice" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:layout_marginTop="8dp" android:text="@string/ui_talk" />
            <Button android:id="@+id/btnAssistantQuickStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="System status" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/tabProjectSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_surface"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnCreateProject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_project" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/project_tab_hint" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabShizukuSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_surface"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shizuku_runtime_status_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvShizukuRuntimeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRefreshShizukuStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/shizuku_refresh_status" />

                <Button
                    android:id="@+id/btnOpenShizukuApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/shizuku_open_app" />

                <Button
                    android:id="@+id/btnRequestShizukuPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/shizuku_request_permission" />

                <EditText
                    android:id="@+id/etShizukuCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/shizuku_command_hint"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/btnRunShizuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/run_shizuku_test" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabStatusSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_surface"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnShowStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_capability_status" />

                <TextView
                    android:id="@+id/tvStatusOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnAutoUpgradeApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_jarvis_core"
                    android:drawablePadding="8dp"
                    android:text="@string/upgrade_latest_build" />

                <TextView
                    android:id="@+id/tvUpdateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:text="@string/update_status_idle"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabTerminalSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_surface"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal_tab_title"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTerminalCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/terminal_command_hint"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/btnTerminalRunCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/terminal_run_command" />

                <Button
                    android:id="@+id/btnTerminalStopCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/terminal_stop_command" />

                <Button
                    android:id="@+id/btnTerminalClearOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/terminal_clear_output" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/terminal_output_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTerminalOutput"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/terminal_history_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTerminalHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabAuditSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_surface"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/audit_tab_title"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAuditLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/audit_limit_hint"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:text="100" />

                <EditText
                    android:id="@+id/etAuditStatusFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/audit_status_filter_hint"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/etAuditAdapterFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/audit_adapter_filter_hint"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/btnAuditRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/audit_refresh_logs" />

                <Button
                    android:id="@+id/btnAuditCopy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/audit_copy_logs" />

                <Button
                    android:id="@+id/btnAuditClearView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/audit_clear_view" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/audit_output_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAuditDebugOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabPermissionsSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_surface"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_tab_title"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRequestAllRuntimePermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/request_all_runtime_permissions" />

                <Button
                    android:id="@+id/btnRequestAllSpecialPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/request_all_special_permissions" />

                <Button
                    android:id="@+id/btnOpenOverlayPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_overlay_permission" />

                <Button
                    android:id="@+id/btnOpenWriteSettingsPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_write_settings_permission" />

                <Button
                    android:id="@+id/btnOpenAllFilesPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_all_files_permission" />

                <Button
                    android:id="@+id/btnOpenUsageAccessPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_usage_access_permission" />

                <Button
                    android:id="@+id/btnOpenBatteryOptimizationPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_battery_optimization_permission" />

                <Button
                    android:id="@+id/btnOpenNotificationPolicyPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_notification_policy_permission" />

                <Button
                    android:id="@+id/btnOpenAccessibilitySettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_accessibility_settings" />

                <Button
                    android:id="@+id/btnOpenDefaultAssistantSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_default_assistant_settings" />

                <TextView
                    android:id="@+id/tvSpecialPermissionsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tabDhizukuSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_surface"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPrivilegeSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/privilege_center_title"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshPrivileges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/refresh_privilege_status" />

                <Button
                    android:id="@+id/btnRequestDhizukuPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/request_dhizuku_permission" />

                <Button
                    android:id="@+id/btnApplyCoreDelegatedScopes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/apply_core_delegated_scopes" />

                <TextView
                    android:id="@+id/tvPrivilegeCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_output_surface"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/device_owner_controls_title"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCameraDisabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/do_camera_disabled" />

                <Button
                    android:id="@+id/btnApplyCameraDisabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_setting" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchScreenCaptureDisabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/do_screen_capture_disabled" />

                <Button
                    android:id="@+id/btnApplyScreenCaptureDisabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_setting" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchInstallAppsRestricted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/do_restrict_install_apps" />

                <Button
                    android:id="@+id/btnApplyInstallAppsRestriction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_setting" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchUninstallAppsRestricted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/do_restrict_uninstall_apps" />

                <Button
                    android:id="@+id/btnApplyUninstallAppsRestriction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_setting" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchStatusBarDisabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/do_disable_status_bar" />

                <Button
                    android:id="@+id/btnApplyStatusBarDisabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_setting" />

                <EditText
                    android:id="@+id/etLockScreenMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/lock_screen_message_hint"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/btnApplyLockScreenMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_lock_screen_message" />

                <EditText
                    android:id="@+id/etPolicyPackageName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/policy_package_name_hint"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPackageUninstallBlocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/do_block_package_uninstall" />

                <Button
                    android:id="@+id/btnApplyPackagePolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_package_policy" />

                <Button
                    android:id="@+id/btnLockNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/do_lock_now" />

                <Button
                    android:id="@+id/btnRebootFromDhizuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/do_reboot_now" />
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/vHudPulseOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.1"
            android:background="@drawable/jarvis_pulse_overlay"
            android:clickable="false"
            android:focusable="false" />

        <View
            android:id="@+id/vScanline"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/jarvis_scanline"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>
</LinearLayout>
