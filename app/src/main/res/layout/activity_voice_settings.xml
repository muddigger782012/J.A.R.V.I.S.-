<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/jarvis_background" android:padding="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_panel_surface" android:padding="16dp" android:orientation="vertical">
    <Button android:id="@+id/btnCloseVoiceSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" style="@style/Widget.AssistantPlatform.QuietButton" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_jarvis_core" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/voice_settings_title" android:textColor="?attr/jarvis_on_dark" android:textStyle="bold" android:textSize="22sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_voice_settings_hint" android:textSize="15sp" android:textColor="?attr/jarvis_on_dark_muted" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
    <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Wake phrase" />
    <EditText android:id="@+id/etWakeWord" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Hey Jarvis" android:inputType="textNoSuggestions" android:minHeight="48dp" />
    <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Say this phrase before your command. Custom phrases use your phone’s speech recognition." android:textSize="12sp" />
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAutoStartVoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/voice_auto_start_label" />
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchPreferOfflineCommand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/voice_prefer_offline_command_label" />
    <Button android:id="@+id/btnToggleAdvancedVoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_advanced_voice" style="@style/Widget.AssistantPlatform.QuietButton" />
    <LinearLayout android:id="@+id/voiceAdvancedOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
      <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchDedicatedWakeWord" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/voice_dedicated_wakeword_label" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:id="@+id/tvWakeSensitivityValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Sensitivity: 0.60" />
      <SeekBar android:id="@+id/seekWakeSensitivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="60" />
      <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchForegroundServiceMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/voice_foreground_mode_label" />
      <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAutoStartForegroundService" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/voice_auto_start_foreground_label" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:id="@+id/tvConfidenceThresholdValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Command confidence threshold: 0.58" />
      <SeekBar android:id="@+id/seekCommandConfidenceThreshold" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="95" android:progress="58" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/default_project_name_label" />
      <EditText android:id="@+id/etDefaultProjectName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/default_project_name_hint" android:inputType="textNoSuggestions" android:minHeight="48dp" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/custom_project_phrases_label" />
      <EditText android:id="@+id/etCustomProjectPhrases" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/custom_phrases_hint" android:inputType="textMultiLine|textNoSuggestions" android:minHeight="48dp" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/custom_status_phrases_label" />
      <EditText android:id="@+id/etCustomStatusPhrases" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/custom_phrases_hint" android:inputType="textMultiLine|textNoSuggestions" android:minHeight="48dp" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/custom_shell_phrases_label" />
      <EditText android:id="@+id/etCustomShellPhrases" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/custom_phrases_hint" android:inputType="textMultiLine|textNoSuggestions" android:minHeight="48dp" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/custom_reboot_phrases_label" />
      <EditText android:id="@+id/etCustomRebootPhrases" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/custom_phrases_hint" android:inputType="textMultiLine|textNoSuggestions" android:minHeight="48dp" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/custom_settings_phrases_label" />
      <EditText android:id="@+id/etCustomSettingsPhrases" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/custom_phrases_hint" android:inputType="textMultiLine|textNoSuggestions" android:minHeight="48dp" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/custom_start_voice_phrases_label" />
      <EditText android:id="@+id/etCustomStartVoicePhrases" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/custom_phrases_hint" android:inputType="textMultiLine|textNoSuggestions" android:minHeight="48dp" />
      <TextView android:textColor="?attr/jarvis_on_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/custom_stop_voice_phrases_label" />
      <EditText android:id="@+id/etCustomStopVoicePhrases" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/custom_phrases_hint" android:inputType="textMultiLine|textNoSuggestions" android:minHeight="48dp" />
    </LinearLayout>
    <Button android:id="@+id/btnToggleCommandExamples" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_command_examples" style="@style/Widget.AssistantPlatform.QuietButton" />
    <TextView android:textColor="?attr/jarvis_on_dark" android:id="@+id/tvVoiceCommandCatalog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="VOICE COMMANDS &amp; ACTIONS\n\nWAKE WORD\n• “Hey Jarvis” — activates command listening. Editable above.\n\nSYSTEM STATUS\n• “status”\n• “capability”\n• “what can you do”\n• “show system status”\nAction: reads current capability/system status.\n\nPROJECTS\n• “create project”\n• “new project”\n• “generate project”\n• “make project”\nExample: “create project named demo”\nAction: creates a local coding project.\n\nPRIVILEGED SHELL\n• “run shell &lt;command&gt;”\n• “execute command &lt;command&gt;”\n• “run command &lt;command&gt;”\nAction: proposes a Shizuku shell command; a separate confirmation is required before execution.\n\nREBOOT\n• “reboot”\n• “restart device”\n• “restart phone”\nAction: requests reboot through the privileged device-control path; explicit separate confirmation is required.\n\nVOICE SETTINGS\n• “open voice settings”\n• “voice settings”\n• “configure voice”\nAction: opens this settings screen.\n\nVOICE ON\n• “start listening”\n• “enable voice”\n• “wake up”\nAction: enables voice listening.\n\nVOICE OFF\n• “stop listening”\n• “stop voice”\n• “go silent”\n• “disable voice”\nAction: stops voice listening.\n\nCUSTOM COMMAND PHRASES\nEach command group below can be manually extended with comma-separated phrases. Saved phrases are added to the built-in phrases, allowing the command vocabulary to grow without replacing defaults." android:textIsSelectable="true" android:visibility="gone" android:textSize="14sp" />
    <Button android:id="@+id/btnSaveVoiceSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/save_voice_settings" />
  </LinearLayout>
</ScrollView>