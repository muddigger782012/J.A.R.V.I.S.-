<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AssistantPlatform.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextColor">?attr/jarvis_on_dark_muted</item>
        <item name="tabSelectedTextColor">?attr/jarvis_primary</item>
        <item name="tabIndicatorColor">?attr/jarvis_neon_green</item>
        <item name="tabRippleColor">?attr/jarvis_neon_green_soft</item>
        <item name="android:background">@drawable/glass_panel_surface</item>
    </style>

    <style name="Widget.AssistantPlatform.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/glass_button_bg</item>
        <item name="android:textColor">?attr/jarvis_on_dark</item>
        <item name="cornerRadius">?attr/jarvis_corner</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.AssistantPlatform.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/glass_edittext_bg</item>
        <item name="android:textColor">?attr/jarvis_on_dark</item>
        <item name="android:textColorHint">?attr/jarvis_on_dark_muted</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.AssistantPlatform.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textColor">?attr/jarvis_on_dark</item>
        <item name="trackTint">?attr/jarvis_surface_stroke</item>
        <item name="thumbTint">?attr/jarvis_primary</item>
    </style>
    <style name="Widget.AssistantPlatform.QuietButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?attr/jarvis_on_dark_muted</item>
        <item name="strokeColor">?attr/jarvis_surface_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">?attr/jarvis_corner</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
</resources>
