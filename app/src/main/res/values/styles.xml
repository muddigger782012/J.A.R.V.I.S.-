<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AssistantPlatform.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextColor">@color/jarvis_on_dark_muted</item>
        <item name="tabSelectedTextColor">@color/jarvis_primary</item>
        <item name="tabIndicatorColor">@color/jarvis_neon_green</item>
        <item name="tabRippleColor">@color/jarvis_neon_green_soft</item>
        <item name="android:background">@drawable/glass_panel_surface</item>
    </style>

    <style name="Widget.AssistantPlatform.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/glass_button_bg</item>
        <item name="android:textColor">@color/jarvis_on_dark</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.AssistantPlatform.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/glass_edittext_bg</item>
        <item name="android:textColor">@color/jarvis_on_dark</item>
        <item name="android:textColorHint">@color/jarvis_on_dark_muted</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.AssistantPlatform.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textColor">@color/jarvis_on_dark</item>
        <item name="trackTint">@color/jarvis_surface_stroke</item>
        <item name="thumbTint">@color/jarvis_primary</item>
    </style>
</resources>
