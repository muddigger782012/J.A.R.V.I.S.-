<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="42dp"
                android:height="42dp" />
            <solid android:color="#2013223A" />
            <stroke
                android:width="1dp"
                android:color="@color/jarvis_primary" />
        </shape>
    </item>

    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#3017A5C7" />
            <stroke
                android:width="1dp"
                android:color="@color/jarvis_neon_green" />
        </shape>
    </item>

    <item
        android:left="15dp"
        android:top="15dp"
        android:right="15dp"
        android:bottom="15dp">
        <shape android:shape="oval">
            <solid android:color="@color/jarvis_neon_green" />
        </shape>
    </item>
</layer-list>
