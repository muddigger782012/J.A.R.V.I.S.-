<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/jarvis_neon_green_soft">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="?attr/jarvis_corner" />
                    <gradient
                        android:angle="0"
                        android:startColor="?attr/jarvis_button_fill"
                        android:endColor="#6636C3A4" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="?attr/jarvis_corner" />
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/jarvis_neon_green_soft" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
